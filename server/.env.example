PORT=5000
NODE_ENV=development

# Supabase PostgreSQL connection string.
# Prefer the Session Pooler URI from Supabase for hosted deployments.
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres
DATABASE_SSL=true

JWT_SECRET=replace-with-a-strong-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
